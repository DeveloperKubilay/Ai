{
  "model": {
    "base_model": "Qwen/Qwen2.5-0.5B-Instruct",
    "tokenizer_source": "Qwen/Qwen2.5-0.5B-Instruct",
    "output_dir": "./qwen-trained-model",
    "system_prompt": "Sen kisa, dogal, yardimci ve durust Turkce cevaplar veren bir asistansin. Emin olmadiginda bunu acikca soyle ve uydurma bilgi verme."
  },
  "training": {
    "num_questions": 25,
    "num_epochs": 30,
    "learning_rate": 0.001,
    "batch_size": 2,
    "gradient_accumulation_steps": 4,
    "lora_r": 16,
    "lora_alpha": 32,
    "seed": 42,
    "auto": {
      "enabled": true
    }
  },
  "teacher": {
    "url": "http://localhost:11434/api/generate",
    "model": "qwen2.5-coder:7b",
    "temperature": 0.8
  },
  "verification": {
    "enabled": false
  },
  "redteam": {
    "apply_repairs": true
  }
}
